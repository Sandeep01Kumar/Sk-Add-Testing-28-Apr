# ----------------------------------------------------------------------------
# .gitignore for the Express.js modernization of the Node.js HTTP server.
#
# Goals:
#   1. Prevent dependency directories (node_modules) from being committed.
#   2. Prevent generated test artifacts (coverage reports, lcov files,
#      Jest caches) from polluting version control.
#   3. Prevent accidental commits of real environment secrets (.env,
#      .env.local, .env.*.local) while INTENTIONALLY tracking the
#      deterministic test-environment fixture file
#      `tests/fixtures/.env.test` (per AAP Section 0.10.1).
#   4. Defensive coverage of common log, build, OS, and editor artifacts.
#
# IMPORTANT: tests/fixtures/.env.test is intentionally committed because
# it contains only deterministic test-environment values
# (NODE_ENV=test, PORT=3000, HOST=127.0.0.1, LOG_LEVEL=silent) and no
# secrets. The patterns below are deliberately scoped to NOT match it:
#   - `.env`            matches the literal filename `.env` only
#   - `.env.local`      matches only `.env.local`
#   - `.env.*.local`    requires a trailing `.local` suffix
#   - `.env.test`       is NOT a pattern in this file
# ----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Test coverage outputs
# Generated by `npm run test:coverage` (Jest --coverage). Includes
# coverage/lcov.info, coverage/lcov-report/, coverage/coverage-final.json,
# and the text/text-summary console reporter has no on-disk artifacts.
# ---------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ---------------------------------------------------------------------------
# Logs
# Winston file transports (when enabled in production) and any package
# manager debug logs.
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Environment files (real secrets — NEVER commit)
#
# NOTE: tests/fixtures/.env.test is intentionally committed and is NOT
# covered by these patterns. Do NOT add `.env.test` or `*.env.test`
# patterns to this file.
# ---------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.production.local
.env.*.local

# ---------------------------------------------------------------------------
# Build outputs (defensive — Express projects sometimes emit to dist/build)
# ---------------------------------------------------------------------------
dist/
build/
.cache/

# ---------------------------------------------------------------------------
# Jest cache directory (defensive — created when --cache is used)
# ---------------------------------------------------------------------------
.jest/

# ---------------------------------------------------------------------------
# Editor / IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS metadata
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# PM2 runtime artifacts
# PM2 stores its runtime state under `.pm2/` when started in development;
# never commit per-machine PM2 state.
# ---------------------------------------------------------------------------
.pm2/
